{
  "name": "@corsica-linea/platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "dev:mobile:phone": "pnpm --filter @corsica/mobile dev:phone",
    "dev:mobile:phone:lan": "pnpm --filter @corsica/mobile dev:phone:lan",
    "assets:optimize": "pnpm --filter @corsica/assets optimize",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "prepare": "lefthook install",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,json,jsonc,md,mdx,yml,yaml,css,scss}": [
      "prettier --write"
    ],
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-unicorn": "^59.0.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.9",
    "lint-staged": "^17.0.8",
    "metro-runtime": "0.83.3",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "turbo": "^2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8",
    "vitest": "^4.1.9"
  }
}
