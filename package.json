{
  "name": "olivier",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:lint": "supabase db lint --local --level error",
    "db:reset": "supabase db reset --local",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "dev": "pnpm --parallel --stream --filter @olivier/web --filter @olivier/api run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --recursive --if-present run lint",
    "security:audit": "pnpm audit --prod --audit-level high",
    "start": "pnpm --parallel --stream --filter @olivier/web --filter @olivier/api run start",
    "test": "pnpm test:database && pnpm --recursive --if-present run test",
    "test:database": "node --test tests/database-migrations.test.mjs",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "find-my-way": "9.7.0",
      "postcss": "8.5.12",
      "sharp": "0.35.3",
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "pgsql-parser": "^17.9.16",
    "prettier": "^3.9.6",
    "supabase": "^2.110.0"
  }
}
