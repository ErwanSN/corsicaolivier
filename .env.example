NODE_ENV=development

WEB_PORT=3000
API_PORT=3001
API_INSTANCE_COUNT=1
MOBILE_PORT=8081

DATABASE_URL=file:./prisma/local.db
BACKUP_DIRECTORY=./backups
BACKUP_RETENTION=7
AUTH_JWT_SECRET=change-me-in-local-env-with-at-least-32-characters
TRUST_PROXY=false
LOG_LEVEL=info
METRICS_TOKEN=change-me-for-production-monitoring-with-at-least-32-characters
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=corsica-api
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

CORS_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://192.168.1.166:3001
