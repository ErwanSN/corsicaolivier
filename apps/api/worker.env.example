NODE_ENV=development

# Runtime worker isolé uniquement : ce secret ne doit jamais être injecté dans
# le service HTTP API ni dans le navigateur.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Le healthcheck CLI lit seulement ce heartbeat local au conteneur worker.
OUTBOX_HEALTH_FILE=/tmp/corsica-outbox-worker.heartbeat
OUTBOX_HEALTH_MAX_AGE_MS=180000
