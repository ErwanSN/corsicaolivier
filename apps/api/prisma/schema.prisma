generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  EMPLOYEE
  ADMIN
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  username               String                  @unique
  passwordHash           String                  @map("password_hash")
  role                   Role                    @default(USER)
  sessionVersion         Int                     @default(1) @map("session_version")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  passwordChangeRequests PasswordChangeRequest[]
  refreshSessions        RefreshSession[]

  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model PasswordChangeRequest {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  status      String   @default("PENDING")
  requestedAt DateTime @default(now()) @map("requested_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("password_change_requests")
}

model PortMapConfiguration {
  id        String   @id @default("main")
  payload   String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("port_map_configurations")
}

model Dossier {
  id            String     @id @default(uuid())
  reference     String     @unique
  phone         String
  normalizedPhone String   @map("normalized_phone")
  routeLabel    String     @map("route_label")
  currencyLabel String     @map("currency_label")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  travelers     Traveler[]
  vehicles      Vehicle[]

  @@index([normalizedPhone])
  @@map("dossiers")
}

model Traveler {
  id             String   @id @default(uuid())
  dossierId      String   @map("dossier_id")
  name           String
  normalizedName String   @map("normalized_name")
  dateLabel      String   @map("date_label")
  status         String
  dossier        Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@index([normalizedName])
  @@map("travelers")
}

model Vehicle {
  id              String   @id @default(uuid())
  dossierId       String   @map("dossier_id")
  model           String
  owner           String
  paid            Boolean  @default(false)
  plate           String
  normalizedPlate String   @map("normalized_plate")
  dossier         Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@index([normalizedPlate])
  @@map("vehicles")
}
