{
  "name": "@corsica/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "android": "expo start --android",
    "build": "echo \"Native builds are handled by EAS profiles.\"",
    "clean": "rimraf .expo dist coverage",
    "dev": "expo start",
    "dev:phone": "expo start --tunnel --go --clear --port 8082",
    "dev:phone:lan": "expo start --lan --go --clear --port 8081",
    "ios": "expo start --ios",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@corsica/api-client": "workspace:*",
    "@corsica/assets": "workspace:*",
    "@corsica/contracts": "workspace:*",
    "@corsica/ui": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "^6.1.2",
    "expo": "^54.0.35",
    "expo-constants": "^57.0.2",
    "expo-font": "^14.0.12",
    "expo-secure-store": "^57.0.0",
    "lucide-react-native": "^1.23.0",
    "react": "^19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "metro-runtime": "0.83.3"
  }
}
