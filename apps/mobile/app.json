{
  "expo": {
    "name": "Corsica Linea",
    "slug": "corsica-linea",
    "scheme": "corsicalinea",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "buildNumber": "1",
      "bundleIdentifier": "com.skynetinitiative.corsica",
      "config": {
        "usesNonExemptEncryption": false
      },
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.skynetinitiative.corsica",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Autoriser Corsica Linea à utiliser Face ID pour sécuriser votre session."
        }
      ]
    ]
  }
}
