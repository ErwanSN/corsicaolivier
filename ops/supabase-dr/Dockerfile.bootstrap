# The qualified Supabase entrypoint needs root only to initialize a brand-new
# PGDATA and then drops the database process to the postgres operating-system
# account. This image is restricted to the isolated, internal DR bootstrap.
FROM public.ecr.aws/supabase/postgres:15.8.1.085@sha256:af083ef64d0408c8f098ee6f5c364a59b26f36fbc0f3a334a62c5c1d57362e9b

COPY bootstrap/webhooks.sql /docker-entrypoint-initdb.d/init-scripts/98-webhooks.sql
COPY bootstrap/jwt.sql.template /docker-entrypoint-initdb.d/init-scripts/99-jwt.sql
COPY bootstrap/roles.sql.template /docker-entrypoint-initdb.d/init-scripts/99-roles.sql
COPY bootstrap/_supabase.sql /docker-entrypoint-initdb.d/migrations/97-_supabase.sql
COPY bootstrap/logs.sql /docker-entrypoint-initdb.d/migrations/99-logs.sql
COPY bootstrap/pooler.sql /docker-entrypoint-initdb.d/migrations/99-pooler.sql
COPY bootstrap/realtime.sql /docker-entrypoint-initdb.d/migrations/99-realtime.sql
